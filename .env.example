# Environment Configuration
NODE_ENV=development
PORT=3000

# Database Configuration
DB_PATH=./data/database.sqlite

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# API Configuration
API_RATE_LIMIT=100
API_RATE_WINDOW=15

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=./logs/app.log